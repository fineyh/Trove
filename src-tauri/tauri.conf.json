{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "0.4.2",
  "identifier": "com.trove.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: http://trove.localhost trove: https://*.tile.openstreetmap.org https://*.googleusercontent.com",
        "media-src": "'self' blob: http://trove.localhost trove:",
        "connect-src": "'self' ipc: http://ipc.localhost http://trove.localhost trove:",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: http://trove.localhost trove: https://*.tile.openstreetmap.org https://*.googleusercontent.com",
        "media-src": "'self' blob: http://trove.localhost trove:",
        "connect-src": "'self' ipc: http://ipc.localhost http://trove.localhost trove: ws://localhost:1420",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fineyh/Trove/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1NTBFQjU1NjE0QzcyMkQKUldRdGNreGhWZXRRMVN6bWYxM0pHN1NZN1NqT01vQjFEZ2dwbHFzNytJcUxXdzMzakVRc3BPaW8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
