# Google Desktop OAuth client.
#
# Copy this file to `src-tauri/.env` (gitignored) and fill in the values from
# Google Cloud Console -> APIs & Services -> Credentials.
#
# The Desktop-client secret is not a true confidentiality boundary: it ships
# inside the distributed binary and PKCE is what secures the flow. It is kept
# out of git only to avoid secret-scanner hits and live-value scraping.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
