# Local build config for Trove — COPY THIS to `config.toml` and edit the paths.
#
#   cp config.toml.example config.toml   (then point the paths at your OpenSSL)
#
# `rusqlite` is built with the `bundled-sqlcipher` feature, which needs OpenSSL
# headers + libs at link time. On a dev machine the easiest source is the
# OpenSSL that ships with Anaconda (any prebuilt 1.1+/3.x install works).
#
# IMPORTANT: config.toml is gitignored on purpose — these paths are
# machine-specific and must NOT be committed. Committing them leaks an absolute
# path into CI, where it doesn't exist, breaking the build. CI resolves OpenSSL
# via vcpkg instead and never reads this file.

[env]
OPENSSL_LIB_DIR = { value = "E:/Tools/anaconda3/Library/lib", force = false }
OPENSSL_INCLUDE_DIR = { value = "E:/Tools/anaconda3/Library/include", force = false }
